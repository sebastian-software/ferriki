{
  "name": "@ferriki/core",
  "version": "0.12.0",
  "description": "native syntax highlighting with HTML and CSS-class output",
  "keywords": [
    "highlighter",
    "napi",
    "rust",
    "shiki",
    "syntax-highlighting",
    "textmate"
  ],
  "homepage": "https://ferriki.dev",
  "bugs": {
    "url": "https://github.com/sebastian-software/ferriki/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/ferriki.git",
    "directory": "node/ferriki"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "assets/shiki",
    "classes.mjs",
    "index.d.mts",
    "index.mjs",
    "macro.d.mts",
    "macro.mjs",
    "native.mjs",
    "platforms.mjs",
    "react-macro.d.mts",
    "react-macro.mjs",
    "src/api.d.mts",
    "src/asset-download.mjs",
    "src/index.mjs",
    "transformers.mjs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./macro": {
      "types": "./macro.d.mts",
      "default": "./macro.mjs"
    },
    "./react/macro": {
      "types": "./react-macro.d.mts",
      "default": "./react-macro.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/build-wrapper.mjs && node ./scripts/verify-wrapper.mjs",
    "dev": "node ./scripts/build-wrapper.mjs && node ./scripts/verify-wrapper.mjs",
    "build:native": "node ./scripts/build-native.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:types"
  },
  "optionalDependencies": {
    "@ferriki/darwin-arm64": "0.12.0",
    "@ferriki/linux-arm64-gnu": "0.12.0",
    "@ferriki/linux-arm64-musl": "0.12.0",
    "@ferriki/linux-x64-gnu": "0.12.0",
    "@ferriki/linux-x64-musl": "0.12.0",
    "@ferriki/win32-arm64-msvc": "0.12.0",
    "@ferriki/win32-x64-msvc": "0.12.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
