{
  "name": "ferriki",
  "type": "module",
  "version": "0.3.0",
  "description": "Shiki-compatible syntax highlighting powered by a native Rust TextMate runtime",
  "license": "MIT",
  "homepage": "https://github.com/sebastian-software/ferriki#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/ferriki.git",
    "directory": "node/ferriki"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/ferriki/issues"
  },
  "keywords": [
    "shiki",
    "syntax-highlighting",
    "highlighter",
    "textmate",
    "rust",
    "napi"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./native": {
      "types": "./native.d.mts",
      "default": "./native.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "assets/shiki",
    "dist/ferriki.*.node",
    "index.d.mts",
    "index.mjs",
    "native.d.mts",
    "native.mjs",
    "platforms.mjs",
    "src/api.d.mts",
    "src/index.mjs",
    "transformers.mjs"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node ./scripts/build-wrapper.mjs && node ./scripts/verify-wrapper.mjs",
    "dev": "node ./scripts/build-wrapper.mjs && node ./scripts/verify-wrapper.mjs",
    "build:native": "node ./scripts/build-native.mjs"
  },
  "optionalDependencies": {
    "@sebastian-software/ferriki-darwin-arm64": "0.3.0",
    "@sebastian-software/ferriki-darwin-x64": "0.3.0",
    "@sebastian-software/ferriki-linux-arm64-gnu": "0.3.0",
    "@sebastian-software/ferriki-linux-x64-gnu": "0.3.0",
    "@sebastian-software/ferriki-win32-x64-msvc": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:types"
  }
}
