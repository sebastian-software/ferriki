{
  "name": "@ferriki/vite",
  "version": "0.12.0",
  "description": "Build-time preparation of Ferriki's inline highlighting macros for Vite",
  "keywords": [
    "ferriki",
    "shiki",
    "syntax-highlighting",
    "vite"
  ],
  "homepage": "https://ferriki.dev",
  "bugs": {
    "url": "https://github.com/sebastian-software/ferriki/issues"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/ferriki.git",
    "directory": "node/vite"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "index.d.mts",
    "index.mjs",
    "macro-scan.mjs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ferriki/core": "0.12.0",
    "magic-string": "catalog:integrations"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
