{
  "name": "ferriki-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --cache",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm -C ferriki build",
    "build:native": "pnpm -C ferriki build:native",
    "prepare:compat": "node ./scripts/prepare-shiki-compat.mjs",
    "check:compat-mirror": "node ./scripts/check-shiki-compat-clean.mjs",
    "check:compat-manifest": "node ./scripts/check-shiki-compat-manifest.mjs",
    "build:compat": "pnpm run prepare:compat && pnpm --filter './compat/upstream/shiki/packages/*' --filter '!@shikijs/langs' --filter '!@shikijs/themes' run --if-present build",
    "test:ferriki-compat": "pnpm run test:ferriki-compat:core",
    "test:ferriki-compat:textmate": "FERRIKI_HONEST_ALIAS=1 vitest run compat/upstream/shiki/packages/core/test/core.test.ts compat/upstream/shiki/packages/shiki/test/injections.test.ts compat/upstream/shiki/packages/shiki/test/general.test.ts -t '^(?!.*should have correct offset)(should|vue-injections|injections-side-effects)' --maxWorkers 1 --no-file-parallelism",
    "test:ferriki-compat:core": "pnpm run build:compat && pnpm -C ferriki build:native && node ./scripts/run-core-compat.mjs && pnpm run test:bench-comparison",
    "test:ferriki-compat:core:full": "pnpm run build:compat && pnpm -C ferriki build:native && FERRIKI_HONEST_ALIAS=1 vitest compat/upstream/shiki/packages/core/test compat/upstream/shiki/packages/shiki/test --run --maxWorkers 1 --no-file-parallelism",
    "test:ferriki-compat:adapters": "pnpm run build:compat && pnpm -C ferriki build:native && vitest compat/upstream/shiki/packages/transformers/test compat/upstream/shiki/packages/twoslash/test --exclude compat/upstream/shiki/packages/twoslash/test/markdown-it.test.ts --run --maxWorkers 1 --no-file-parallelism",
    "test:ferriki-compat:colorized-brackets": "pnpm run build:compat && pnpm -C ferriki build:native && node ./compat/harness/run-colorized-brackets-compat.mjs",
    "check:classes": "node ./scripts/check-class-highlighting.mjs",
    "check:errors": "node ./scripts/check-ferriki-errors.mjs",
    "check:remote-assets": "node ./scripts/check-ferriki-remote-assets.mjs",
    "check:platform-package": "node ./scripts/check-platform-package.mjs",
    "check:packed-sidecar": "node ./scripts/check-packed-sidecar.mjs",
    "check:api": "node ./scripts/check-generated-api.mjs",
    "check:api-contract": "node ./scripts/check-ferriki-api-contract.mjs",
    "check:boundary": "node ./scripts/check-native-boundary.mjs",
    "check:release": "node ./scripts/check-release-workflow.mjs && node ./scripts/test-release-workflow-contract.mjs && node ./scripts/test-release-summary.mjs && node ./scripts/test-npm-publish-verification.mjs",
    "check:transformers": "node ./scripts/check-ferriki-transformers.mjs",
    "check:token-state": "node ./scripts/check-ferriki-token-state.mjs",
    "check:ferromark-ardo": "node ./scripts/check-ferromark-ardo-contract.mjs",
    "check:platform-matrix": "node ./scripts/check-ferriki-platform-matrix.mjs",
    "check:docs": "node ./scripts/check-docs-contract.mjs && node ./scripts/check-packed-consumer.mjs",
    "check:docs-drift": "node ./scripts/check-docs-drift.mjs && node ./scripts/test-docs-drift.mjs",
    "test:vite": "vitest run vite/test/plugin.test.mjs",
    "check:packed-vite": "node ./scripts/check-packed-vite-consumer.mjs",
    "publish:ci": "pnpm -C ferriki publish --access public --no-git-checks",
    "bench:tiobe": "node scripts/bench-tiobe.mjs",
    "check:bench-tiobe": "node scripts/check-bench-tiobe.mjs",
    "bench:curated": "node scripts/bench-tiobe.mjs --corpus curated",
    "check:bench-curated": "node scripts/check-bench-curated.mjs",
    "capture:prism-quality": "node scripts/capture-prism-quality.mjs",
    "bench:prism-output-modes": "node scripts/bench-prism-output-modes.mjs",
    "capture:prism-profiles": "node scripts/capture-prism-profiles.mjs",
    "summarize:prism-profiles": "node scripts/summarize-prism-profiles.mjs",
    "bench:comparison": "node scripts/bench-shiki-comparison.mjs",
    "test:bench-comparison": "node --test scripts/test-phiki-html-agreement.mjs scripts/test-phiki-benchmark.mjs scripts/test-blacksmith-comparison.mjs",
    "check:inline-macro": "node ./scripts/check-inline-macro-browser.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@jridgewell/trace-mapping": "catalog:testing",
    "@napi-rs/cli": "catalog:cli",
    "@rollup/plugin-commonjs": "catalog:bundling",
    "@rollup/plugin-json": "catalog:bundling",
    "@rollup/plugin-node-resolve": "catalog:bundling",
    "@shikijs/colorized-brackets": "workspace:*",
    "@shikijs/core": "workspace:*",
    "@shikijs/engine-javascript": "workspace:*",
    "@shikijs/engine-oniguruma": "workspace:*",
    "@shikijs/langs": "workspace:*",
    "@shikijs/primitive": "workspace:*",
    "@shikijs/themes": "workspace:*",
    "@shikijs/transformers": "workspace:*",
    "@shikijs/twoslash": "workspace:*",
    "@shikijs/types": "workspace:*",
    "@types/fs-extra": "catalog:types",
    "@types/node": "catalog:types",
    "ansi-sequence-parser": "catalog:inlined",
    "eslint": "catalog:cli",
    "fast-glob": "catalog:testing",
    "fs-extra": "catalog:testing",
    "hast-util-from-html": "catalog:inlined",
    "hast-util-to-html": "catalog:inlined",
    "hast-util-to-string": "catalog:inlined",
    "oxfmt": "catalog:cli",
    "pathe": "catalog:bundling",
    "prismjs": "catalog:",
    "rimraf": "catalog:cli",
    "rollup": "catalog:bundling",
    "rollup-plugin-dts": "catalog:bundling",
    "rollup-plugin-esbuild": "catalog:bundling",
    "shiki": "workspace:*",
    "tm-grammars": "catalog:inlined",
    "tm-themes": "catalog:inlined",
    "tsdown": "catalog:bundling",
    "tsx": "catalog:cli",
    "twoslash": "catalog:integrations",
    "typescript": "catalog:cli",
    "unist-util-visit": "catalog:integrations",
    "vite": "catalog:bundling",
    "vite-tsconfig-paths": "catalog:bundling",
    "vitest": "catalog:testing",
    "vue": "catalog:docs"
  },
  "resolutions": {
    "typescript": "catalog:cli",
    "vite": "catalog:bundling"
  },
  "packageManager": "pnpm@10.28.2"
}
