{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    "node/ferriki": {
      "component": "ferriki",
      "package-name": "ferriki",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "/node/ferriki/package.json",
          "jsonpath": "$.optionalDependencies[*]"
        },
        {
          "type": "json",
          "path": "/node/platforms/*/package.json",
          "glob": true,
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "/node/pnpm-lock.yaml",
          "jsonpath": "$.importers.ferriki.optionalDependencies[*].specifier"
        }
      ]
    }
  }
}
