{
  "name": "ferriki-homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-site-data.mjs && ardo dev",
    "verify": "pnpm sample:check && pnpm prism-sample:check && pnpm class-sample:check && pnpm macro-sample:check && pnpm footprint:check && pnpm guide-samples:check && pnpm lint && pnpm typecheck && pnpm format:check && pnpm build && pnpm browser:check",
    "build": "node ../scripts/publish-blacksmith-evidence.mjs --check && node ../scripts/publish-memory-evidence.mjs --check && node ../scripts/publish-regex-mode-evidence.mjs --check && node ../scripts/publish-decoded-cache-evidence.mjs --check && node scripts/write-site-data.mjs && ardo build && node scripts/verify-build.mjs",
    "class-sample:write": "node scripts/render-class-sample.mjs",
    "class-sample:check": "node scripts/render-class-sample.mjs --check",
    "footprint:write": "node scripts/write-footprint.mjs",
    "footprint:check": "node scripts/write-footprint.mjs --check",
    "macro-sample:write": "node scripts/render-macro-sample.mjs",
    "macro-sample:check": "node scripts/render-macro-sample.mjs --check",
    "sample:write": "node scripts/render-sample.mjs",
    "sample:check": "node scripts/render-sample.mjs --check",
    "guide-samples:check": "node scripts/check-guide-examples.mjs",
    "browser:check": "node scripts/check-browser.mjs",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint --config oxlint.config.ts .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "ardo preview",
    "typecheck": "node scripts/write-site-data.mjs && tsc --noEmit",
    "prism-sample:write": "node ../node/scripts/render-prism-comparison.mjs",
    "prism-sample:check": "node ../node/scripts/render-prism-comparison.mjs --check"
  },
  "dependencies": {
    "ardo": "^6.0.0",
    "ferramenta-family": "github:sebastian-software/ferramenta#0e22e8aa755fce55287a1a26a66f5e8de5b91f29&path:/packages/family"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
